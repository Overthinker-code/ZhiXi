# Single-machine competition profile. Copy to code/.env.competition and fill secrets.
# Never commit the populated file. Recommended permissions: chmod 600 code/.env.competition
# Generate a JWT secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Database/admin passwords must be at least 12 characters and must not be placeholders.
ENVIRONMENT=production
SECRET_KEY=
PROJECT_NAME=ZhiXi
FRONTEND_HOST=http://127.0.0.1:5174
BACKEND_CORS_ORIGINS=http://127.0.0.1:5174
TRUSTED_HOSTS=127.0.0.1,localhost

POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=app
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=
BACKEND_WORKERS=1

ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_REQUEST_SIZE=27262976
MAX_UPLOAD_SIZE=26214400
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AI_SSE_MAX_CONCURRENT_PER_USER=2
AI_SYNC_MAX_CONCURRENT_PER_USER=1
AI_RATE_LIMIT_REQUESTS=12
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_SSE_TIMEOUT_SECONDS=180
AI_SYNC_TIMEOUT_SECONDS=240
CONTENT_SAFETY_PROVIDER=local
CONTENT_SAFETY_API_URL=
CONTENT_SAFETY_API_KEY=
CONTENT_SAFETY_TIMEOUT_SECONDS=2.5
EMBEDDINGS_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDINGS_MODEL=qwen3-embedding:0.6b
# Keep indexes provider/model-specific; never reuse a hash-vector collection.
CHROMA_DB_PATH=./vector_db-qwen3-embedding-0.6b
RAG_COURSE_SEMANTIC_MIN_SCORE=0.34
WS_ALLOW_QUERY_TOKEN_IN_LOCAL=false
CODE_SANDBOX_ENABLED=false
ENABLE_MOCK_ROUTES=false
DEVELOPER_PANEL_ENABLED=false
