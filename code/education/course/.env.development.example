# 本地全栈模式：前端本机 -> 后端本机
# 1) 启动 PostgreSQL，并确保 code/.env 中 POSTGRES_* 指向本机数据库
# 2) 启动后端：cd code/backend && ../.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8001
# 3) 启动前端：cd code/education/course && npm run dev
#
# 如果使用远程后端或 SSH 隧道，可把下面改为 http://127.0.0.1:18001

VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8001
VITE_AXIOS_TIMEOUT_MS=120000
VITE_AUTH_TIMEOUT_MS=6000
