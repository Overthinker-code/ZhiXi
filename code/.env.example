PROJECT_NAME=ZhiXi
ENVIRONMENT=local
# Local-only placeholder: startup warns but remains usable. Production rejects it.
SECRET_KEY=changethis

FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

# Security/session defaults for the student web app.
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_REQUEST_SIZE=27262976
MAX_UPLOAD_SIZE=26214400
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
POSTGRES_DB=zhixi

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
EMAIL_TEST_USER=test@example.com

SMTP_TLS=true
SMTP_SSL=true
SMTP_PORT=465
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=ZhiXi

CHAT_PROVIDER=mimo
CHAT_MODEL=mimo-v2.5-pro
CHAT_TEMPERATURE=0.0
CHAT_DEFAULT_MAX_TOKENS=16384
CHAT_SUPERVISOR_MAX_TOKENS=4096
CHAT_CONTEXT_HEAD_MESSAGES=1
CHAT_CONTEXT_TAIL_MESSAGES=16
CHAT_CONTEXT_MAX_MESSAGE_CHARS=8000

EMBEDDINGS_PROVIDER=hash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_EMBEDDINGS_MODEL=nomic-embed-text
VECTOR_STORE_TYPE=chroma

OPENAI_API_KEY=
OPENAI_API_BASE=

MIMO_API_KEY=
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_CHAT_MODEL=mimo-v2.5-pro
MIMO_FAST_MODEL=mimo-v2.5
MIMO_MULTIMODAL_MODEL=mimo-v2.5
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TIMEOUT_SECONDS=120
RESOURCE_GENERATION_AI_ENABLED=true
RESOURCE_GENERATION_TIMEOUT_SECONDS=45

# Independent content moderation. Set provider=http only for a dedicated
# moderation API; do not point this at a general chat-completions endpoint.
CONTENT_SAFETY_PROVIDER=local
CONTENT_SAFETY_API_URL=
CONTENT_SAFETY_API_KEY=
CONTENT_SAFETY_TIMEOUT_SECONDS=2.5

MULTIMODAL_PROVIDER=mimo
MULTIMODAL_MODEL=mimo-v2.5
MULTIMODAL_FALLBACK_MODEL=mimo-v2.5-pro
MULTIMODAL_API_BASE=
MULTIMODAL_API_KEY=
MULTIMODAL_TIMEOUT_SECONDS=180

RAG_TOP_K=4
RAG_HASH_MIN_LEXICAL_SCORE=0.15
RAG_VECTOR_MIN_SCORE=0.20
RAG_LEXICAL_MAX_DOCUMENTS=2500
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

REDIS_BROKER_URL=redis://127.0.0.1:6379/0
REDIS_RESULT_BACKEND=redis://127.0.0.1:6379/1
START_CELERY_SERVICE=false
START_YOLO_SERVICE=false
YOLO_SERVICE_HOST=http://127.0.0.1
YOLO_SERVICE_PORT=8002

DIGITAL_HUMAN_ENGINE=musetalk
DIGITAL_HUMAN_ALLOW_FALLBACK_RENDERER=true
DIGITAL_HUMAN_EDGE_TTS_BIN=
DIGITAL_HUMAN_EDGE_TTS_VOICE=zh-CN-YunxiNeural
DIGITAL_HUMAN_EDGE_TTS_FALLBACK_VOICES=zh-CN-XiaoxiaoNeural,zh-CN-YunjianNeural,zh-CN-YunyangNeural
DIGITAL_HUMAN_EDGE_TTS_RETRIES=2
DIGITAL_HUMAN_RENDER_TIMEOUT_SECONDS=1800
DIGITAL_HUMAN_CELERY_ENABLED=true
DIGITAL_HUMAN_MUSETALK_CONDA_BIN=conda
DIGITAL_HUMAN_MUSETALK_CONDA_ENV=MuseTalk
DIGITAL_HUMAN_MUSETALK_PYTHON=
DIGITAL_HUMAN_FFMPEG_PATH=

MEMORY_PROFILE_AUTO_REFRESH=true
MEMORY_PROFILE_MAX_TURNS=20
MEMORY_PROFILE_MAX_CHARS=12000
LEARNING_REPORT_LLM_TIMEOUT_SECONDS=8
DEMO_MODE=false
DEMO_FAKE_CHAT_CACHE=false
DEVELOPER_PANEL_ENABLED=true
ENABLE_MOCK_ROUTES=false

# 讯飞/星火 API 预留（赛题合规，未配置时回退 CHAT_PROVIDER）
IFLYTEK_APP_ID=
IFLYTEK_API_KEY=
IFLYTEK_API_SECRET=
IFLYTEK_SPARK_MODEL=generalv3.5
# Font name stored in generated Word files. Use a CJK font installed on demo clients.
ZHIXI_DOCX_FONT_NAME=Noto Sans CJK SC
